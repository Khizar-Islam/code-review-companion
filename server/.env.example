# Copy to .env and fill in. Never commit .env.
DATABASE_URL=
DIRECT_URL=
GITHUB_TOKEN=
GEMINI_API_KEY=
# Same value as API_AUTH_SECRET in web/.env.local
API_AUTH_SECRET=
# Comma-separated, e.g. http://localhost:3000,https://your-site.vercel.app
WEB_ORIGIN=http://localhost:3000
# Optional. Number of proxies in front of the API in production, 1 to 5, default 1.
# Only used when NODE_ENV=production or RENDER=true.
# On Render this must be 3 (measured: visitor, Cloudflare, Render proxy). Too low makes every
# visitor share one rate-limit counter; too high lets visitors fake their IP.
TRUST_PROXY_HOPS=
